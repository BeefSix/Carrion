; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Carrion Prototype"
config/description="Asymmetric three-faction zombie-apocalypse RTS. Prototype testing the Military vs Tribal asymmetric thesis. See PROTOTYPE_PLAN.md for the 6-week scope."
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoloads/GameState.gd"
SimRng="*res://autoloads/SimRng.gd"
IsoView="*res://autoloads/IsoView.gd"
SquadManager="*res://autoloads/SquadManager.gd"
ProjectileManager="*res://autoloads/ProjectileManager.gd"
NoiseBus="*res://autoloads/NoiseBus.gd"
PerfProbe="*res://autoloads/PerfProbe.gd"
MatchStats="*res://autoloads/MatchStats.gd"
ReplayRecorder="*res://autoloads/ReplayRecorder.gd"
CommandBus="*res://autoloads/CommandBus.gd"
SimChecksum="*res://autoloads/SimChecksum.gd"
SteeringField="*res://autoloads/SteeringField.gd"
WorldConstants="*res://autoloads/WorldConstants.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
