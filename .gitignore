# Godot 4+ build artifacts and editor cache
.godot/
/android/
/build/

# Godot import cache
.import/
*.import

# Godot script UID sidecars (regenerated locally; solo project doesn't need them in VCS)
*.uid

# Export configuration (may contain paths or secrets)
export.cfg
export_presets.cfg

# Imported translations (auto-generated from CSV)
*.translation

# Mono / .NET (not used in this project, but ignore in case)
.mono/
data_*/
mono_crash.*.json

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# Claude Code local permission grants (per-machine, not shared)
.claude/settings.local.json

# Local toolchain (Godot exe extracted for headless parse checks)
.tools/

# Headless perf/diagnostic logs (created at runtime by Godot --headless runs)
# Not part of the repo - rerun the diagnostic to regenerate.
/*.log
